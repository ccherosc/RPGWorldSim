{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],

    "baseUrl": ".",
    "paths": {
      "@rpgsim/shared": ["packages/shared/src/index.ts"],
      "@rpgsim/shared/*": ["packages/shared/src/*"],
      "@rpgsim/sim-core": ["packages/sim-core/src/index.ts"],
      "@rpgsim/sim-core/*": ["packages/sim-core/src/*"],
      "@rpgsim/world": ["packages/world/src/index.ts"],
      "@rpgsim/world/*": ["packages/world/src/*"],
      "@rpgsim/npc": ["packages/npc/src/index.ts"],
      "@rpgsim/npc/*": ["packages/npc/src/*"],
      "@rpgsim/society": ["packages/society/src/index.ts"],
      "@rpgsim/society/*": ["packages/society/src/*"],
      "@rpgsim/chronicle": ["packages/chronicle/src/index.ts"],
      "@rpgsim/chronicle/*": ["packages/chronicle/src/*"]
    }
  }
}
